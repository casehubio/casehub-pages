{
  "name": "@casehubio/yaml-core",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./expand": {
      "types": "./dist/expand.d.ts",
      "default": "./dist/expand.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./orchestration": {
      "types": "./dist/orchestration/index.d.ts",
      "default": "./dist/orchestration/index.js"
    },
    "./condition": {
      "types": "./dist/condition/condition-evaluator.d.ts",
      "default": "./dist/condition/condition-evaluator.js"
    },
    "./step": {
      "types": "./dist/step/index.d.ts",
      "default": "./dist/step/index.js"
    },
    "./step/diff": {
      "types": "./dist/step/diff.d.ts",
      "default": "./dist/step/diff.js"
    },
    "./patterns": {
      "types": "./dist/patterns.d.ts",
      "default": "./dist/patterns.js"
    }
  },
  "devDependencies": {
    "@casehubio/pages-tsconfig": "workspace:*",
    "typescript": "~5.8.0",
    "vitest": "^3.2.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
