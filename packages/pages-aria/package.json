{
  "name": "@casehubio/pages-aria",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["dist/*.js", "src/controller/standalone.ts", "src/controller/step-catalog.ts", "src/controller/scenario-controller.ts", "src/controller/scenario-narrative.ts", "src/controller/scenario-yaml-viewer.ts", "src/controller/library-view.ts", "src/tutorial/tutorial-host.ts"],
  "exports": {
    "./walker": "./src/walker/index.ts",
    "./executor": "./src/executor/index.ts",
    "./server": "./src/server/index.ts",
    "./scenario": "./src/scenario/index.ts",
    "./controller": "./src/controller/index.ts",
    "./tutorial": "./src/tutorial/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "build:controller": "node ../../node_modules/esbuild/bin/esbuild src/controller/standalone.ts --bundle --format=esm --outfile=dist/controller.js --target=es2022 --tsconfig=tsconfig.json",
    "build:tutorial": "node ../../node_modules/esbuild/bin/esbuild src/tutorial/standalone.ts --bundle --format=esm --outfile=dist/tutorial.js --target=es2022 --tsconfig=tsconfig.json",
    "build": "yarn build:controller && yarn build:tutorial"
  },
  "dependencies": {
    "@casehubio/pages-data": "workspace:*",
    "@casehubio/pages-primitives": "workspace:*",
    "@casehubio/yaml-core": "workspace:*",
    "lit": "^3.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
